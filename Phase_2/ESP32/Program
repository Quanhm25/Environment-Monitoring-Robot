#include <WiFi.h>
#include <WebServer.h>
#include <WebSocketsServer.h>
#include <LittleFS.h>

const char* ssid = "";
const char* password = "";

WebServer server(80);
WebSocketsServer webSocket(81);


// Khai báo chân cho UART2 (để giao tiếp với STM32)
#define RXD2 4
#define TXD2 5

#pragma pack(push,1)
typedef struct {
  uint8_t start;
  float temperature;
  float humidity;
  float smoke_ppm;
  float light_lux;
  uint8_t crc;
  uint8_t end;
} SensorDataFrame_t;
#pragma pack(pop)

//Biến toàn cục lưu data do sensor gửi về
float g_temp = 0, g_hum = 0, g_lux = 0, g_ppm = 0;
uint8_t frameBuf[sizeof(SensorDataFrame_t)];
uint8_t frameIdx = 0;
bool syncing = true;


void handleFileRequest(String path) {
  if(path == "/") path = "/index.html";
  String contentType = "text/plain";
  if(path.endsWith(".html")) contentType = "text/html";
  else if(path.endsWith(".css")) contentType = "text/css";
  else if(path.endsWith(".js")) contentType = "application/javascript";

  if(LittleFS.exists(path)) {
    File file = LittleFS.open(path, "r");
    server.streamFile(file, contentType);
    file.close();
  } else {
    server.send(404, "text/plain", "File not found");
  }
}

void sendMotorCmd(char cmd) {
  static char last = 0;
  Serial2.write(cmd);
  if(cmd != last) {
    Serial.printf("[CMD] %c\n", cmd);
    last = cmd;
  }
}

void webSocketEvent(uint8_t num, WStype_t type, uint8_t* payload, size_t length) {
  switch(type) {
    case WStype_DISCONNECTED:
    Serial.printf("[WS %u] Disconnected, STOP\n", num);
    sendMotorCmd('S');
    break;

    case WStype_CONNECTED:
    Serial.printf("[WS %u] Connected\n", num);
    break;

    case WStype_TEXT: {
      if(length != 1) return;
      char cmd = (char)payload[0];
      if(cmd == 'F' || cmd == 'B' || cmd == 'L' || cmd == 'R' || cmd == 'S') {
        sendMotorCmd(cmd);
      }
      break;
    }

    default:
    break;
  }
}

uint8_t CRC8_Calc(const uint8_t *data, uint8_t len) {
  uint8_t crc = 0;
  for(uint8_t i = 0; i < len; i++) {
    crc ^= data[i];
    for(uint8_t b = 0; b < 8; b++) {
      crc = (crc&0x80) ? (crc<<1) ^ 0x07 : (crc<<1);
    }
  }
  return crc;
}

void pollSensorUART() {
  while(Serial2.available()) {
    uint8_t b = Serial2.read();
    if(syncing) {
      if(b == 0xAA) {frameBuf[0] = b; frameIdx = 1; syncing = false;}
      continue;
    }
    frameBuf[frameIdx++] = b;
    if(frameIdx == sizeof(SensorDataFrame_t)) {
      SensorDataFrame_t *f = (SensorDataFrame_t*)frameBuf;
      uint8_t crc = CRC8_Calc((uint8_t*)&f->temperature, 16);
      if(f->end == 0x55 && crc == f->crc) {
        g_temp = f->temperature; g_hum = f->humidity;
        g_ppm = f->smoke_ppm; g_lux = f->light_lux;
        
        String json = "{\"thermal\":" + String(g_temp,1) +
                      ",\"humidity\":" + String(g_hum,1) +
                      ",\"smoke\":" + String(g_ppm, 3) +
                      ",\"light\":" + String(g_lux,1) + "}";
        webSocket.broadcastTXT(json);
      }
      syncing = true;
    }
  }
}

void setup() {
  Serial.begin(115200);
 
  // Khởi tạo Serial2 để giao tiếp với STM32
  Serial2.begin(115200, SERIAL_8N1, RXD2, TXD2);

  WiFi.begin(ssid, password);
  Serial.print("Connecting to WiFi");
  while(WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }
  Serial.println();
  Serial.print("ESP32 IP: ");
  Serial.println(WiFi.localIP());

  if(!LittleFS.begin()) {
    Serial.println("LittleFS Mount Failed");
    return;
  }

  server.on("/", HTTP_GET, []() {handleFileRequest("/index.html");});
  server.on("/styles.css", HTTP_GET, []() {handleFileRequest("/styles.css");});
  server.on("/script.js", HTTP_GET, []() {handleFileRequest("/script.js");});
  server.begin();
 
  webSocket.begin();
  webSocket.onEvent(webSocketEvent);

  Serial.println("HTTP + WebSocket server started");
}

void loop() {
  server.handleClient();
  webSocket.loop();
  pollSensorUART();
}
